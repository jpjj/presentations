{
  "name": "linkedin_posts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "slidev presentations/hands-on-modeling/slides.md --open",
    "dev:hands-on": "slidev presentations/hands-on-modeling/slides.md --open",
    "dev:freelance": "slidev presentations/freelance-or/slides.md --open",
    "dev:freelance-carousel": "slidev presentations/freelance-or-carousel/slides.md --open",
    "build": "slidev build presentations/hands-on-modeling/slides.md",
    "build:hands-on": "slidev build presentations/hands-on-modeling/slides.md",
    "build:freelance": "slidev build presentations/freelance-or/slides.md",
    "build:freelance-carousel": "slidev build presentations/freelance-or-carousel/slides.md",
    "export:freelance-carousel": "slidev export presentations/freelance-or-carousel/slides.md --format pdf --output presentations/freelance-or-carousel/freelance-or-carousel.pdf",
    "export": "slidev export presentations/hands-on-modeling/slides.md"
  },
  "dependencies": {
    "@slidev/cli": "^52.11.3",
    "@slidev/theme-apple-basic": "^0.25.1",
    "@slidev/theme-default": "latest",
    "@slidev/theme-seriph": "latest",
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "prettier": "^3.8.0",
    "prettier-plugin-slidev": "^1.0.5"
  },
  "prettier": {
    "overrides": [
      {
        "files": [
          "presentations/**/slides.md",
          "presentations/**/*.md"
        ],
        "options": {
          "parser": "slidev",
          "plugins": [
            "prettier-plugin-slidev"
          ]
        }
      }
    ]
  }
}